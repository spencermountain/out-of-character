{
  "name": "char-out",
  "version": "3.0.0",
  "description": "remove invisible unicode characters",
  "license": "MIT",
  "repository": "github:spencermountain/char-out",
  "homepage": "https://work.spencermountain.dev/char-out",
  "author": "Spencer Kelly and Adam Tsiopani",
  "contributors": [
    "Frazer Smith <frazer.dev@icloud.com> (https://github.com/fdawgs)"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/char-out.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/char-out.cjs"
      }
    }
  },
  "main": "./builds/char-out.cjs",
  "types": "./types/index.d.ts",
  "bin": {
    "char-out": "bin/char-out.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tape \"./tests/**/*.test.js\" | tap-dancer  --color always",
    "watch": "node --watch ./scratch.js",
    "lint": "eslint .",
    "build": "node ./scripts/version.js && node ./scripts/data.js && rollup -c --silent",
    "version": "node ./scripts/version.js",
    "unicode:check": "node ./scripts/unicode-check.js"
  },
  "files": [
    "bin/",
    "builds/",
    "src/",
    "types/"
  ],
  "keywords": [
    "unicode",
    "invisible"
  ],
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  },
  "devDependencies": {
    "@rollup/plugin-terser": "1.0.2",
    "eslint": "10.15.0",
    "rollup": "4.68.8",
    "rollup-plugin-filesize-check": "2.0.1",
    "tap-dancer": "0.4.4",
    "tape": "5.11.0"
  },
  "unpkg": "./builds/char-out.min.js"
}
