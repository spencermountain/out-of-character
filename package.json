{
  "name": "out-of-character",
  "version": "3.1.0",
  "description": "renamed to char-out - remove invisible unicode characters",
  "license": "MIT",
  "repository": "github:spencermountain/char-out",
  "homepage": "https://work.spencermountain.dev/char-out",
  "author": "Spencer Kelly and Adam Tsiopani",
  "contributors": [
    "Frazer Smith <frazer.dev@icloud.com> (https://github.com/fdawgs)"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./index.cjs"
      }
    }
  },
  "main": "./index.cjs",
  "types": "./types/index.d.ts",
  "bin": {
    "out-of-character": "bin/out-of-character.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node ./test.js"
  },
  "files": [
    "bin/",
    "index.js",
    "index.cjs",
    "types/"
  ],
  "keywords": [
    "unicode",
    "invisible"
  ],
  "dependencies": {
    "char-out": "^3.0.0"
  }
}
