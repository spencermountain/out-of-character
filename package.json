{
  "name": "out-of-character",
  "version": "2.3.0",
  "description": "remove invisible unicode characters",
  "license": "MIT",
  "repository": "github:spencermountain/out-of-character",
  "homepage": "https://work.spencermountain.dev/out-of-character",
  "author": "Spencer Kelly and Adam Tsiopani",
  "contributors": [
    "Frazer Smith <frazer.dev@icloud.com> (https://github.com/fdawgs)"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./builds/out-of-character.mjs"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./builds/out-of-character.cjs"
      }
    }
  },
  "main": "./builds/out-of-character.cjs",
  "types": "./types/index.d.ts",
  "bin": {
    "out-of-character": "./bin/out-of-character.js"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "tape \"./tests/**/*.test.js\" | tap-dancer  --color always",
    "testb": "TESTENV=prod tape \"./tests/**/*.test.js\" | tap-dancer  --color always",
    "watch": "node --watch ./scratch.js",
    "lint": "eslint .",
    "lint:lockfile": "npx lockfile-lint -p package-lock.json -t npm -a npm -s -i",
    "build": "rollup -c --silent",
    "config:view": "npx http-server . -o=public"
  },
  "files": [
    "bin/",
    "builds/",
    "data/characters.json",
    "src/",
    "types/"
  ],
  "keywords": [
    "unicode",
    "invisible"
  ],
  "dependencies": {
    "colorette": "^2.0.20",
    "glob": "13.0.6"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "1.0.0",
    "eslint": "10.11.0",
    "rollup": "4.63.5",
    "rollup-plugin-filesize-check": "2.0.1",
    "shelljs": "0.10.0",
    "tap-dancer": "0.4.3",
    "tape": "5.10.2"
  },
  "unpkg": "./builds/out-of-character.min.js",
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  }
}
